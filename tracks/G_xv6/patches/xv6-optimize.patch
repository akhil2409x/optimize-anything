diff --git a/user/schedbench.c b/user/schedbench.c
new file mode 100644
index 0000000..f847c95
--- /dev/null
+++ b/user/schedbench.c
@@ -0,0 +1,163 @@
+// Track G: scheduler benchmark. Same program on the RR and MLFQ kernels.
+//
+//   schedbench cpu        4 identical CPU-bound jobs (batch throughput)
+//   schedbench mixed      3 CPU-bound jobs + 2 interactive jobs (short burst, then sleep 1 tick)
+//   schedbench shortlong  2 long jobs start first, then 4 short jobs arrive 0.5 s later
+//   schedbench shortlate  same, but the short jobs arrive 1.5 s later (long jobs have
+//                         had time to sink to the lowest MLFQ level)
+//
+// Work is measured in loop iterations. `schedbench <workload> <iters_per_tick>`
+// uses a fixed amount of work per "tick", so every kernel runs IDENTICAL work.
+// `schedbench calib` measures iters_per_tick once. (An earlier version
+// calibrated inside every run; because the calibration loop is itself
+// interrupted by the scheduler, MLFQ measured ~9% more iterations per tick and
+// was handed 9% more work - see docs/failure_log.md F8.)
+// Output lines (parsed by run_benchmarks.py), times in microseconds:
+//   R wl=<workload> cls=<class> turn=<turnaround> resp=<response> run=<cpu time> nsched=<n> level=<l>
+//   L wl=mixed lat_mean=<us> lat_max=<us> rounds=<n>      (interactive wake-up latency)
+//   T wl=<workload> makespan=<us>
+#include "kernel/types.h"
+#include "kernel/stat.h"
+#include "kernel/stats.h"
+#include "user/user.h"
+
+#define US(t) ((t) / 10)            // time CSR runs at 10 MHz: 10 units = 1 us
+#define TICK 1000000UL              // 0.1 s in time-CSR units
+
+static uint64 iters_per_tick;
+
+static void
+spin(uint64 iters)
+{
+  volatile uint64 x = 0;
+  for (uint64 i = 0; i < iters; i++)
+    x += i;
+}
+
+static void
+calibrate(void)
+{
+  uint64 n = 100000, t;
+  for (;;) {                        // grow until one measurement takes >= 0.3 s
+    uint64 t0 = rtime();
+    spin(n);
+    t = rtime() - t0;
+    if (t >= 3 * TICK)
+      break;
+    n *= 2;
+  }
+  iters_per_tick = n * TICK / t;
+}
+
+static int
+start_cpu(int ticks_of_work)
+{
+  int pid = fork();
+  if (pid == 0) {
+    spin(ticks_of_work * iters_per_tick);
+    exit(0);
+  }
+  return pid;
+}
+
+// interactive job: `rounds` times, do ~2% of a tick of work, then sleep 1 tick.
+// Reports the mean and max time from asking to sleep to running again.
+static int
+start_interactive(int rounds, int report_fd)
+{
+  int pid = fork();
+  if (pid == 0) {
+    uint64 total = 0, worst = 0;
+    for (int r = 0; r < rounds; r++) {
+      spin(iters_per_tick / 50);
+      uint64 t0 = rtime();
+      pause(1);
+      uint64 lat = rtime() - t0;
+      total += lat;
+      if (lat > worst)
+        worst = lat;
+    }
+    uint64 res[2] = {total / rounds, worst};
+    write(report_fd, res, sizeof(res));
+    exit(0);
+  }
+  return pid;
+}
+
+struct job {
+  int pid;
+  char *cls;
+};
+
+static void
+reap(char *wl, struct job *jobs, int n)
+{
+  for (int k = 0; k < n; k++) {
+    struct procstat ps;
+    int st;
+    int pid = waitstat(&st, &ps);
+    char *cls = "?";
+    for (int j = 0; j < n; j++)
+      if (jobs[j].pid == pid)
+        cls = jobs[j].cls;
+    printf("R wl=%s cls=%s turn=%lu resp=%lu run=%lu nsched=%d level=%d\n", wl, cls,
+           US(ps.etime - ps.ctime), US(ps.firstrun - ps.ctime), US(ps.rtime), ps.nsched,
+           ps.level);
+  }
+}
+
+int
+main(int argc, char *argv[])
+{
+  if (argc < 2) {
+    printf("usage: schedbench calib | schedbench cpu|mixed|shortlong|shortlate <iters_per_tick>\n");
+    exit(1);
+  }
+  char *wl = argv[1];
+  if (strcmp(wl, "calib") == 0) {
+    calibrate();
+    printf("CALIB iters_per_tick=%lu\n", iters_per_tick);
+    exit(0);
+  }
+  if (argc < 3) {
+    printf("schedbench: give iters_per_tick (from 'schedbench calib')\n");
+    exit(1);
+  }
+  iters_per_tick = atoi(argv[2]);
+  struct job jobs[8];
+  int n = 0;
+  uint64 t0 = rtime();
+
+  if (strcmp(wl, "cpu") == 0) {
+    for (int i = 0; i < 4; i++)
+      jobs[n++] = (struct job){start_cpu(20), "cpu"};
+    reap(wl, jobs, n);
+  } else if (strcmp(wl, "mixed") == 0) {
+    int p[2];
+    pipe(p);
+    for (int i = 0; i < 3; i++)
+      jobs[n++] = (struct job){start_cpu(30), "cpu"};
+    for (int i = 0; i < 2; i++)
+      jobs[n++] = (struct job){start_interactive(40, p[1]), "interactive"};
+    reap(wl, jobs, n);
+    for (int i = 0; i < 2; i++) {
+      uint64 res[2];
+      read(p[0], res, sizeof(res));
+      printf("L wl=%s lat_mean=%lu lat_max=%lu rounds=40\n", wl, US(res[0]), US(res[1]));
+    }
+  } else if (strcmp(wl, "shortlong") == 0 || strcmp(wl, "shortlate") == 0) {
+    for (int i = 0; i < 2; i++)
+      jobs[n++] = (struct job){start_cpu(40), "long"};
+    // head start for the long jobs. Sinking to the lowest MLFQ level takes
+    // 1 + 2 = 3 ticks of CPU each; 0.5 s shared by two jobs is only ~2.5 ticks each.
+    pause(strcmp(wl, "shortlong") == 0 ? 5 : 15);
+    for (int i = 0; i < 4; i++)
+      jobs[n++] = (struct job){start_cpu(3), "short"};
+    reap(wl, jobs, n);
+  } else {
+    printf("unknown workload %s\n", wl);
+    exit(1);
+  }
+  printf("T wl=%s makespan=%lu iters_per_tick=%lu\n", wl, US(rtime() - t0), iters_per_tick);
+  exit(0);
+}
