diff --git a/kernel/kalloc.c b/kernel/kalloc.c
index 2fcec38..5f1d922 100644
--- a/kernel/kalloc.c
+++ b/kernel/kalloc.c
@@ -18,9 +18,17 @@ struct run {
   struct run *next;
 };
 
+// Track G: every physical page carries a reference count, so that a page
+// shared copy-on-write by several page tables is freed only when the last
+// one drops it. Counts are protected by kmem.lock. Without COW every count
+// is 0 (free) or 1 (in use), which is the original behaviour.
+#define PA2IDX(pa) (((uint64)(pa) - KERNBASE) / PGSIZE)
+
 struct {
   struct spinlock lock;
   struct run *freelist;
+  uint64 nfree;                                  // free pages (for memstat)
+  int refcnt[(PHYSTOP - KERNBASE) / PGSIZE];
 } kmem;
 
 void
@@ -35,8 +43,10 @@ freerange(void *pa_start, void *pa_end)
 {
   char *p;
   p = (char *)PGROUNDUP((uint64)pa_start);
-  for (; p + PGSIZE <= (char *)pa_end; p += PGSIZE)
+  for (; p + PGSIZE <= (char *)pa_end; p += PGSIZE) {
+    kmem.refcnt[PA2IDX(p)] = 1;                  // kfree() below drops it to 0
     kfree(p);
+  }
 }
 
 // Free the page of physical memory pointed at by pa,
@@ -51,6 +61,16 @@ kfree(void *pa)
   if (((uint64)pa % PGSIZE) != 0 || (char *)pa < end || (uint64)pa >= PHYSTOP)
     panic("kfree");
 
+  // Drop one reference; only the last one really frees the page.
+  acquire(&kmem.lock);
+  if (kmem.refcnt[PA2IDX(pa)] <= 0)
+    panic("kfree: refcnt");
+  if (--kmem.refcnt[PA2IDX(pa)] > 0) {
+    release(&kmem.lock);
+    return;
+  }
+  release(&kmem.lock);
+
   // Fill with junk to catch dangling refs.
   memset(pa, 1, PGSIZE);
 
@@ -59,6 +79,7 @@ kfree(void *pa)
   acquire(&kmem.lock);
   r->next = kmem.freelist;
   kmem.freelist = r;
+  kmem.nfree++;
   release(&kmem.lock);
 }
 
@@ -72,11 +93,47 @@ kalloc(void)
 
   acquire(&kmem.lock);
   r = kmem.freelist;
-  if (r)
+  if (r) {
     kmem.freelist = r->next;
+    kmem.nfree--;
+    if (kmem.refcnt[PA2IDX(r)] != 0)
+      panic("kalloc: refcnt");
+    kmem.refcnt[PA2IDX(r)] = 1;
+  }
   release(&kmem.lock);
 
   if (r)
     memset((char *)r, 5, PGSIZE); // fill with junk
   return (void *)r;
 }
+
+// Track G: add a reference to an allocated page (a new COW sharer).
+void
+krefinc(void *pa)
+{
+  acquire(&kmem.lock);
+  if (kmem.refcnt[PA2IDX(pa)] <= 0)
+    panic("krefinc");
+  kmem.refcnt[PA2IDX(pa)]++;
+  release(&kmem.lock);
+}
+
+int
+krefcnt(void *pa)
+{
+  int n;
+  acquire(&kmem.lock);
+  n = kmem.refcnt[PA2IDX(pa)];
+  release(&kmem.lock);
+  return n;
+}
+
+uint64
+kfreepages(void)
+{
+  uint64 n;
+  acquire(&kmem.lock);
+  n = kmem.nfree;
+  release(&kmem.lock);
+  return n;
+}
