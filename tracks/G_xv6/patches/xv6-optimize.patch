+// Track G: statistics returned to user space by waitstat() and memstat().
+// Times are in units of the RISC-V `time` CSR (10 MHz on QEMU virt: 1 unit = 100 ns).
+struct procstat {
+  uint64 ctime;     // when the process was created
+  uint64 firstrun;  // first time it was given a CPU
+  uint64 etime;     // when it exited
+  uint64 rtime;     // total time spent running on a CPU
+  int nsched;       // number of times it was scheduled
+  int level;        // MLFQ level at exit (always 0 for RR)
+};
+
+struct memstat {
+  uint64 freepages;      // free physical pages right now
+  uint64 fork_copied;    // pages copied eagerly by fork (original xv6 behaviour)
+  uint64 cow_faults;     // write faults on copy-on-write pages
+  uint64 cow_copies;     // pages actually copied on such faults
+  uint64 cow_reused;     // faults resolved without a copy (last sharer)
+};
