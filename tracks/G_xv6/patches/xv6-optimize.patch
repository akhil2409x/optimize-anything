diff --git a/Makefile b/Makefile
index a26f3db..3309544 100644
--- a/Makefile
+++ b/Makefile
@@ -79,6 +79,19 @@ CFLAGS += -fno-builtin-free
 CFLAGS += -fno-builtin-memcpy -Wno-main
 CFLAGS += -fno-builtin-printf -fno-builtin-fprintf -fno-builtin-vprintf
 CFLAGS += -I.
+
+# Track G (Optimize Anything): build-time feature switches so the same
+# benchmarks can be run on the original and the optimized kernels.
+#   make SCHED=MLFQ   multilevel feedback queue scheduler (default RR = original)
+#   make COW=1        copy-on-write fork            (default 0  = original eager copy)
+SCHED ?= RR
+COW ?= 0
+ifeq ($(SCHED),MLFQ)
+CFLAGS += -DSCHED_MLFQ
+endif
+ifeq ($(COW),1)
+CFLAGS += -DCOW
+endif
 CFLAGS += $(shell $(CC) -fno-stack-protector -E -x c /dev/null >/dev/null 2>&1 && echo -fno-stack-protector)
 
