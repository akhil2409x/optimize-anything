+// Track G: run p on this CPU (p->lock held, p RUNNABLE) and account for it.
+static void
+run(struct cpu *c, struct proc *p)
+{
+  uint64 start = r_time();
+  if (p->firstrun == 0)
+    p->firstrun = start;
+  p->nsched++;
+  p->state = RUNNING;
+  c->proc = p;
+  swtch(&c->context, &p->context);
+
+  // Don't re-enable interrupts on release.
+  mycpu()->intena = 0;
+
+  // Process is done running for now.
+  // It should have changed its p->state before coming back.
+  c->proc = 0;
+  p->rtime += r_time() - start;
+}
+
+#ifndef SCHED_MLFQ
+// Original xv6 policy: round robin over the process table, one tick each.
 void
 scheduler(void)
 {
@@ -448,16 +496,7 @@ scheduler(void)
         // Switch to chosen process.  It is the process's job
         // to release its lock and then reacquire it
         // before jumping back to us.
-        p->state = RUNNING;
-        c->proc = p;
-        swtch(&c->context, &p->context);
-
-        // Don't re-enable interrupts on release.
-        mycpu()->intena = 0;
-
-        // Process is done running for now.
-        // It should have changed its p->state before coming back.
-        c->proc = 0;
+        run(c, p);
         found = 1;
       }
       release(&p->lock);
@@ -468,6 +507,104 @@ scheduler(void)
     }
   }
 }
+#else
+// Track G: multilevel feedback queue.
+//  - always run a RUNNABLE process from the highest-priority (lowest-numbered)
+//    non-empty level; round robin within a level;
+//  - quantum doubles per level (1, 2, 4 ticks); using a whole quantum demotes
+//    the process (see mlfq_tick); time used at a level is NOT reset by sleeping,
+//    so a process cannot stay on top by yielding just before its quantum ends;
+//  - every MLFQ_BOOST ticks all processes return to level 0 (no starvation).
+static int rr_next[NMLFQ];    // round-robin position per level (shared by CPUs; a hint only)
+
+void
+scheduler(void)
+{
+  struct proc *p;
+  struct cpu *c = mycpu();
+
+  c->proc = 0;
+  for (;;) {
+    intr_on();
+    intr_off();
+
+    // 1. highest level with a runnable process (racy scan; re-checked under the lock)
+    int best = NMLFQ;
+    for (p = proc; p < &proc[NPROC]; p++) {
+      if (p->state == RUNNABLE && p->level < best)
+        best = p->level;
+    }
+    if (best == NMLFQ) {
+      asm volatile("wfi");
+      continue;
+    }
+
+    // 2. round robin within that level, starting after the last one run
+    int start = rr_next[best];
+    for (int k = 0; k < NPROC; k++) {
+      int i = (start + k) % NPROC;
+      p = &proc[i];
+      acquire(&p->lock);
+      if (p->state == RUNNABLE && p->level == best) {
+        rr_next[best] = (i + 1) % NPROC;
+        run(c, p);
+        release(&p->lock);
+        break;
+      }
+      release(&p->lock);
+    }
+  }
+}
+
+static const int mlfq_quantum[NMLFQ] = {1, 2, 4};
+
+// Is any process RUNNABLE at a higher priority than `level`? (racy, a hint)
+static int
+mlfq_higher_runnable(int level)
+{
+  for (struct proc *q = proc; q < &proc[NPROC]; q++)
+    if (q->state == RUNNABLE && q->level < level)
+      return 1;
+  return 0;
+}
+
+// Priority boost: everyone back to the top. Called from clockintr on CPU 0.
+void
+mlfq_boost(void)
+{
+  for (struct proc *q = proc; q < &proc[NPROC]; q++) {
+    acquire(&q->lock);
+    q->level = 0;
+    q->ticks_used = 0;
+    release(&q->lock);
+  }
+}
+#endif
+
+// Track G: called on every timer interrupt taken while process p is running.
+// Returns 1 if p should give up the CPU now.
+int
+sched_tick(struct proc *p)
+{
+#ifndef SCHED_MLFQ
+  (void)p;
+  return 1;                                   // original: yield every tick
+#else
+  int yield_now = 0;
+  acquire(&p->lock);
+  p->ticks_used++;
+  if (p->ticks_used >= mlfq_quantum[p->level]) {
+    if (p->level < NMLFQ - 1)
+      p->level++;                             // used its whole quantum: demote
+    p->ticks_used = 0;
+    yield_now = 1;
+  } else if (mlfq_higher_runnable(p->level)) {
+    yield_now = 1;                            // preempt for a higher-priority process
+  }
+  release(&p->lock);
+  return yield_now;
+#endif
+}
 
