+err:
+  uvmunmap(new, 0, i / PGSIZE, 1);
+  return -1;
+}
+#else
+// Track G, copy-on-write fork: instead of copying each page, map the
+// parent's physical page into the child as well. Writable pages become
+// read-only + PTE_COW in BOTH page tables; the first write by either process
+// faults into cowfault(), which gives the writer a private copy. Read-only
+// pages (program text) are simply shared. Each sharer holds a reference.
+int
+uvmcopy(pagetable_t old, pagetable_t new, uint64 sz)
+{
+  pte_t *pte;
+  uint64 pa, i;
+  uint flags;
+
+  for (i = 0; i < sz; i += PGSIZE) {
+    if ((pte = walk(old, i, 0)) == 0)
+      continue; // page table entry hasn't been allocated
+    if ((*pte & PTE_V) == 0)
+      continue; // physical page hasn't been allocated (lazy sbrk)
+    pa = PTE2PA(*pte);
+    if (*pte & PTE_W)
+      *pte = (*pte & ~PTE_W) | PTE_COW;   // parent loses write access too
+    flags = PTE_FLAGS(*pte);
+    if (mappages(new, i, PGSIZE, pa, flags) != 0)
+      goto err;
+    krefinc((void *)pa);
   }
+  // The parent's TLB may still hold writable translations for the pages we
+  // just made read-only. userret flushes on the way back to user space, but
+  // flush here too so correctness does not depend on that.
+  sfence_vma();
   return 0;
 
 err:
+  // undo the child's mappings (drops the references taken so far); the
+  // parent's pages stay read-only + COW, which is still correct.
   uvmunmap(new, 0, i / PGSIZE, 1);
   return -1;
 }
+#endif
+
+// Track G: resolve a write to a copy-on-write page at va.
+// Returns 0 on success (the page is now private and writable),
+// -1 if va is not a COW page or memory is exhausted.
+int
+cowfault(pagetable_t pagetable, uint64 va)
+{
+  pte_t *pte;
+  uint64 pa;
+  uint flags;
+  char *mem;
+
+  if (va >= MAXVA)
+    return -1;
+  va = PGROUNDDOWN(va);
+  if ((pte = walk(pagetable, va, 0)) == 0)
+    return -1;
+  if ((*pte & PTE_V) == 0 || (*pte & PTE_U) == 0 || (*pte & PTE_COW) == 0)
+    return -1;
+  pa = PTE2PA(*pte);
+  flags = (PTE_FLAGS(*pte) | PTE_W) & ~PTE_COW;
+  vmstats.cow_faults++;
+
+  if (krefcnt((void *)pa) == 1) {
+    // last sharer: no copy needed, just take the page back
+    *pte = PA2PTE(pa) | flags;
+    vmstats.cow_reused++;
+  } else {
+    if ((mem = kalloc()) == 0)
+      return -1;
+    memmove(mem, (char *)pa, PGSIZE);
+    *pte = PA2PTE(mem) | flags;
+    kfree((void *)pa);                     // drop our reference to the shared page
+    vmstats.cow_copies++;
+  }
+  sfence_vma();
+  return 0;
+}
+
+int
+iscowpage(pagetable_t pagetable, uint64 va)
+{
+  pte_t *pte;
+  if (va >= MAXVA)
+    return 0;
+  if ((pte = walk(pagetable, PGROUNDDOWN(va), 0)) == 0)
+    return 0;
+  return (*pte & PTE_V) && (*pte & PTE_U) && (*pte & PTE_COW);
+}
 
 // mark a PTE invalid for user access.
 // used by exec for the user stack guard page.
@@ -360,6 +455,14 @@ copyout(pagetable_t pagetable, uint64 psz, uint64 dstva, char *src, uint64 len)
     }
 
     pte = walk(pagetable, va0, 0);
+    // Track G: the kernel is about to write into this user page. If it is
+    // shared copy-on-write, give this process its own copy first; writing
+    // into the shared page would change the other sharers' memory.
+    if (*pte & PTE_COW) {
+      if (cowfault(pagetable, va0) < 0)
+        return -1;
+      pa0 = walkaddr(pagetable, va0);
+    }
     // forbid copyout over read-only user text pages.
     if ((*pte & PTE_W) == 0)
       return -1;
diff --git a/user/cowbench.c b/user/cowbench.c
new file mode 100644
index 0000000..c8f4b02
--- /dev/null
+++ b/user/cowbench.c
@@ -0,0 +1,114 @@
+// Track G: fork benchmark. Same program on the eager-copy and COW kernels.
+// The parent first allocates and touches a heap of PAGES pages.
+//
+//   cowbench forkexit   child exits immediately          (fork + wait cost)
+//   cowbench forkexec   child execs a do-nothing program (the shell pattern)
+//   cowbench forkread   child reads every heap page
+//   cowbench forkwrite  child writes every heap page     (worst case for COW)
+//   cowbench capacity   keep forking children that stay alive: how many fit in RAM?
+//
+// Output (parsed by run_benchmarks.py), times in microseconds:
+//   C wl=<w> iters=<n> mean_us=<t> copied=<pages> cow_faults=<n> cow_copies=<n> free_min=<pages>
+#include "kernel/types.h"
+#include "kernel/stat.h"
+#include "kernel/stats.h"
+#include "user/user.h"
+
+#define PG 4096
+#define PAGES 1024                   // 4 MB heap
+#define ITERS 20
+
+static uint64 free_min = ~0UL;
+
+static void
+note_free(void)
+{
+  struct memstat m;
+  memstat(&m);
+  if (m.freepages < free_min)
+    free_min = m.freepages;
+}
+
+int
+main(int argc, char *argv[])
+{
+  if (argc < 2) {
+    printf("usage: cowbench forkexit|forkexec|forkread|forkwrite|capacity\n");
+    exit(1);
+  }
+  char *wl = argv[1];
+  int heap_pages = strcmp(wl, "capacity") == 0 ? 4096 : PAGES;   // capacity: 16 MB
+  char *heap = sbrk(heap_pages * PG);
+  if (heap == SBRK_ERROR) {
+    printf("cowbench: sbrk failed\n");
+    exit(1);
+  }
+  for (int i = 0; i < heap_pages; i++)
+    heap[i * PG] = (char)i;
+
+  struct memstat m0, m1;
+  memstat(&m0);
+
+  if (strcmp(wl, "capacity") == 0) {
+    int p[2];
+    pipe(p);
+    int kids = 0;
+    for (; kids < 40; kids++) {
+      int pid = fork();
+      if (pid < 0)
+        break;
+      if (pid == 0) {
+        char c;
+        close(p[1]);
+        heap[kids * PG] = 'x';      // each child dirties one page
+        read(p[0], &c, 1);          // stay alive until the parent closes the pipe
+        exit(0);
+      }
+      note_free();
+    }
+    close(p[0]);
+    close(p[1]);                    // release the children
+    while (wait(0) > 0)
+      ;
+    memstat(&m1);
+    printf("C wl=%s iters=%d mean_us=0 copied=%lu cow_faults=%lu cow_copies=%lu free_min=%lu children=%d\n",
+           wl, kids, m1.fork_copied - m0.fork_copied, m1.cow_faults - m0.cow_faults,
+           m1.cow_copies - m0.cow_copies, free_min, kids);
+    exit(0);
+  }
+
+  uint64 total = 0;
+  for (int it = 0; it < ITERS; it++) {
+    uint64 t0 = rtime();
+    int pid = fork();
+    if (pid < 0) {
+      printf("cowbench: fork failed\n");
+      exit(1);
+    }
+    if (pid == 0) {
+      if (strcmp(wl, "forkexec") == 0) {
+        char *args[] = {"nop", 0};
+        exec("nop", args);
+        exit(1);
+      }
+      if (strcmp(wl, "forkread") == 0) {
+        volatile int sum = 0;
+        for (int i = 0; i < PAGES; i++)
+          sum += heap[i * PG];
+      }
+      if (strcmp(wl, "forkwrite") == 0) {
+        for (int i = 0; i < PAGES; i++)
+          heap[i * PG] = 'w';
+      }
+      exit(0);
+    }
+    note_free();
+    wait(0);
+    total += rtime() - t0;
+  }
+  memstat(&m1);
+  printf("C wl=%s iters=%d mean_us=%lu copied=%lu cow_faults=%lu cow_copies=%lu free_min=%lu\n", wl,
+         ITERS, total / ITERS / 10, m1.fork_copied - m0.fork_copied, m1.cow_faults - m0.cow_faults,
+         m1.cow_copies - m0.cow_copies, free_min);
+  exit(0);
+}
diff --git a/user/cowtest.c b/user/cowtest.c
new file mode 100644
index 0000000..77f337d
--- /dev/null
+++ b/user/cowtest.c
@@ -0,0 +1,168 @@
+// Track G: correctness tests for fork semantics. They must pass on BOTH the
+// original kernel (eager copy) and the copy-on-write kernel, because COW is
+// supposed to be invisible to programs.
+#include "kernel/types.h"
+#include "kernel/stat.h"
+#include "kernel/stats.h"
+#include "user/user.h"
+
+#define NPAGES 256          // 1 MB test region
+#define PG 4096
+
+static int failures = 0;
+
+static void
+check(int ok, char *what)
+{
+  if (!ok) {
+    printf("cowtest: FAIL %s\n", what);
+    failures++;
+  }
+}
+
+static char *
+region(void)
+{
+  char *m = sbrk(NPAGES * PG);
+  if (m == SBRK_ERROR) {
+    printf("cowtest: sbrk failed\n");
+    exit(1);
+  }
+  for (int i = 0; i < NPAGES; i++)
+    m[i * PG] = (char)(i & 0x7f);
+  return m;
+}
+
+// 1. child sees the parent's data; child's writes stay private
+static void
+test_isolation(char *m)
+{
+  int pid = fork();
+  if (pid == 0) {
+    int ok = 1;
+    for (int i = 0; i < NPAGES; i++)
+      if (m[i * PG] != (char)(i & 0x7f))
+        ok = 0;
+    for (int i = 0; i < NPAGES; i++)
+      m[i * PG] = 'C';
+    for (int i = 0; i < NPAGES; i++)
+      if (m[i * PG] != 'C')
+        ok = 0;
+    exit(ok ? 0 : 1);
+  }
+  int st;
+  wait(&st);
+  check(st == 0, "child did not see parent data or could not write");
+  int ok = 1;
+  for (int i = 0; i < NPAGES; i++)
+    if (m[i * PG] != (char)(i & 0x7f))
+      ok = 0;
+  check(ok, "child's writes leaked into the parent");
+}
+
+// 2. parent writes after fork; child must still see the old values
+static void
+test_parent_writes(char *m)
+{
+  int p[2];
+  pipe(p);
+  int pid = fork();
+  if (pid == 0) {
+    char c;
+    close(p[1]);
+    read(p[0], &c, 1);            // wait until the parent has written
+    int ok = 1;
+    for (int i = 0; i < NPAGES; i++)
+      if (m[i * PG] != (char)(i & 0x7f))
+        ok = 0;
+    exit(ok ? 0 : 1);
+  }
+  close(p[0]);
+  for (int i = 0; i < NPAGES; i++)
+    m[i * PG] = 'P';
+  write(p[1], "x", 1);
+  close(p[1]);
+  int st;
+  wait(&st);
+  check(st == 0, "parent's writes leaked into the child");
+  for (int i = 0; i < NPAGES; i++)
+    m[i * PG] = (char)(i & 0x7f);  // restore
+}
+
+// 3. the KERNEL writes into a shared page (read() -> copyout) in the child
+static void
+test_kernel_write(char *m)
+{
+  int p[2];
+  pipe(p);
+  int pid = fork();
+  if (pid == 0) {
+    close(p[1]);
+    int n = read(p[0], m + 5 * PG, 8);      // copyout into a COW page
+    exit(n == 8 && m[5 * PG] == 'K' ? 0 : 1);
+  }
+  close(p[0]);
+  write(p[1], "KKKKKKKK", 8);
+  close(p[1]);
+  int st;
+  wait(&st);
+  check(st == 0, "read() into a shared page failed in the child");
+  check(m[5 * PG] == (char)5, "kernel write in the child changed the parent's page");
+}
+
+// 4. grandchildren: three generations share pages
+static void
+test_generations(char *m)
+{
+  int pid = fork();
+  if (pid == 0) {
+    int pid2 = fork();
+    if (pid2 == 0) {
+      int ok = m[7 * PG] == (char)7;
+      m[7 * PG] = 'G';
+      exit(ok && m[7 * PG] == 'G' ? 0 : 1);
+    }
+    int st2;
+    wait(&st2);
+    exit(st2 == 0 && m[7 * PG] == (char)7 ? 0 : 1);
+  }
+  int st;
+  wait(&st);
+  check(st == 0, "grandchild sharing");
+  check(m[7 * PG] == (char)7, "grandchild write reached the grandparent");
+}
+
+// 5. no physical pages leak across many forks
+static void
+test_no_leak(char *m)
+{
+  struct memstat before, after;
+  memstat(&before);
+  for (int r = 0; r < 30; r++) {
+    int pid = fork();
+    if (pid == 0) {
+      for (int i = 0; i < NPAGES; i += 2)
+        m[i * PG] = 'L';
+      exit(0);
+    }
+    wait(0);
+  }
+  memstat(&after);
+  check(after.freepages == before.freepages, "physical pages leaked");
+  if (after.freepages != before.freepages)
+    printf("cowtest: free pages before %lu after %lu\n", before.freepages, after.freepages);
+}
+
+int
+main(void)
+{
+  char *m = region();
+  test_isolation(m);
+  test_parent_writes(m);
+  test_kernel_write(m);
+  test_generations(m);
+  test_no_leak(m);
+  if (failures == 0)
+    printf("cowtest: OK\n");
+  exit(failures ? 1 : 0);
+}
