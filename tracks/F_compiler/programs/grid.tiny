# nested loops over a 40 x 40 "matrix": address arithmetic with loop-invariant
# parts and multiplications by powers of two (LICM + strength reduction)
N = 40; W = 8; base = 1000; s = 0; i = 0;
while (i < N) {
  j = 0;
  while (j < N) {
    row = base + i * N * W;
    addr = row + j * W;
    s = s + addr % 97 + (i * N * W) / 64;
    j = j + 1;
  }
  i = i + 1;
}
print s;
